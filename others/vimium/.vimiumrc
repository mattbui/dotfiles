# Key mappings

# disable single character vomnibar shortcuts
# too easy to acidental trigger
unmap t
unmap o
unmap O
unmap b
unmap B

map <down> scrollDown
map <up> scrollUp

map <PageUp> scrollPageUp
map <PageDown> scrollPageDown
map <c-d> scrollPageDown
map <c-u> scrollPageUp

map < goBack
map > goForward

unmap J
map J nextTab
unmap K
map K previousTab

unmap H
unmap L
map H moveTabLeft
map L moveTabRight

unmap W
map W closeOtherTabs
map gb visitPreviousTab
map g0 lastTab

map <m-b> Vomnibar.activateBookmarks
map <m-p> Vomnibar.activateTabSelection
map <m-k> Vomnibar.activateInNewTab
# map <m-t> Vomnibar.activateInNewTab
# map <m-l> Vomnibar.activateEditUrl

unmap yy
map yl copyCurrentUrl
map yyp duplicateTab

map ' Marks.activateGotoMode

# disable aggressive space to scroll
map <space><space> scrollDown
map <s-space> scrollUp
