# skhd hotkeys for yabai

# Some macOS apps can stay frontmost after Cmd-W with no visible focused yabai
# window. `->` lets Cmd-W reach the app while refocus.sh restores focus if the
# close event leaves focus stale. Notes needs this because it keeps an invisible
# AX window; Messages/Finder also get this as a backup for inconsistent close
# signal timing.
cmd - w -> [
  "notes"    : $HOME/.config/yabai/scripts/refocus.sh
  "messages" : $HOME/.config/yabai/scripts/refocus.sh
  "finder"   : $HOME/.config/yabai/scripts/refocus.sh
  "calendar" : $HOME/.config/yabai/scripts/refocus.sh
  "spark desktop" : $HOME/.config/yabai/scripts/refocus.sh
  *          ~
]

cmd + shift - w -> [
  "chatgpt" : yabai -m window --focus recent
  *          ~
]

# Focus windows.
# skip-focus mark enables the next yabai space/display-change hook to redirect
# focus away from skip apps like Antinote; it is short-lived and consumed once.
alt - h : yabai -m window --focus west || ($HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus prev) || ($HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus last)
alt - l : yabai -m window --focus east || ($HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus next) || ($HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus first)
alt - j : yabai -m window --focus south || yabai -m window --focus stack.next || yabai -m window --focus stack.first
alt - k : yabai -m window --focus north || yabai -m window --focus stack.prev || yabai -m window --focus stack.last
escape [
  "antinote" : yabai -m window --focus recent
  * ~
]

# Yabai controls.
alt + shift - r : $HOME/.config/yabai/scripts/restart-yabai.sh
alt - d : $HOME/.config/yabai/scripts/label-spaces-displays.sh --notify
alt - 0x2F : app=$(yabai -m query --windows --window | jq -r '.app // empty'); [ -n "$app" ] && $HOME/.config/yabai/scripts/ignore-list.sh toggle "$app"

# Move the focused window between stacks or spaces.
alt + shift - h : $HOME/.config/yabai/scripts/move-to-stack.sh left
alt + shift - j : $HOME/.config/yabai/scripts/move-to-stack.sh bottom
alt + shift - k : $HOME/.config/yabai/scripts/move-to-stack.sh top
alt + shift - l : $HOME/.config/yabai/scripts/move-to-stack.sh right
cmd + alt - h : $HOME/.config/yabai/scripts/move-to-space.sh prev
cmd + alt - l : $HOME/.config/yabai/scripts/move-to-space.sh next
cmd + alt - left : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus prev || yabai -m space --focus last
cmd + alt - right : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus next || yabai -m space --focus first

# Resize focused window/pane.
alt - 0x1B : $HOME/.config/yabai/scripts/resize.sh shrink
alt - 0x18 : $HOME/.config/yabai/scripts/resize.sh grow
alt + shift - 0x1B : $HOME/.config/yabai/scripts/resize.sh shrink 4
alt + shift - 0x18 : $HOME/.config/yabai/scripts/resize.sh grow 4

# Focus/open applications.
cmd + alt + ctrl - s : $HOME/.config/yabai/scripts/focus-app.sh Slack
cmd + alt + ctrl + shift - s : $HOME/.config/yabai/scripts/focus-app.sh "Spark Desktop"
cmd + alt + ctrl - t : $HOME/.config/yabai/scripts/focus-app.sh Alacritty
cmd + alt + ctrl + shift - t : $HOME/.config/yabai/scripts/focus-app.sh Ghostty
cmd + alt + ctrl - c : $HOME/.config/yabai/scripts/focus-app.sh ChatGPT
cmd + alt + ctrl - b : $HOME/.config/yabai/scripts/focus-app.sh Arc
cmd + alt + ctrl - d : $HOME/.config/yabai/scripts/focus-app.sh Discord
cmd + alt + ctrl - f : $HOME/.config/yabai/scripts/focus-app.sh Finder
cmd + alt + ctrl + shift - f : $HOME/.config/yabai/scripts/focus-app.sh FindMy
cmd + alt + ctrl - m : $HOME/.config/yabai/scripts/focus-app.sh Messages

# Toggle float modes.
alt - c : $HOME/.config/yabai/scripts/toggle-float.sh center
alt - return : $HOME/.config/yabai/scripts/toggle-float.sh fullscreen

# Toggle, inspect, repair, or reset the flexible layout.
alt - t : $HOME/.config/yabai/scripts/select-layout.sh toggle
alt - r : $HOME/.config/yabai/scripts/apply-layout.sh
alt - 0 : $HOME/.config/yabai/scripts/apply-layout.sh reset
alt - i : $HOME/.config/yabai/scripts/inspect-layout.sh

# Focus displays by physical left-to-right order.
# Mark before explicit display focus so the yabai hook can skip floating overlays.
alt - 1 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m display --focus display-1
alt - 2 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m display --focus display-2
alt - 3 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m display --focus display-3
alt - 4 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m display --focus display-4

# Move focused window to displays and follow it.
alt + cmd - 1 : yabai -m window --display display-1; yabai -m display --focus display-1
alt + cmd - 2 : yabai -m window --display display-2; yabai -m display --focus display-2
alt + cmd - 3 : yabai -m window --display display-3; yabai -m display --focus display-3
alt + cmd - 4 : yabai -m window --display display-4; yabai -m display --focus display-4

# Focus specific space bindings.
# Mark before explicit display focus so the yabai hook can skip floating overlays.
ctrl - 1 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-1
ctrl - 2 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-2
ctrl - 3 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-3
ctrl - 4 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-4
ctrl - 5 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-5
ctrl - 6 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-6
ctrl - 7 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-7
ctrl - 8 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-8
ctrl - 9 : $HOME/.config/yabai/scripts/skip-focus.sh mark; yabai -m space --focus space-9

# Move focused window to spaces and follow it.
ctrl + cmd - 1 : $HOME/.config/yabai/scripts/move-to-space.sh space-1
ctrl + cmd - 2 : $HOME/.config/yabai/scripts/move-to-space.sh space-2
ctrl + cmd - 3 : $HOME/.config/yabai/scripts/move-to-space.sh space-3
ctrl + cmd - 4 : $HOME/.config/yabai/scripts/move-to-space.sh space-4
ctrl + cmd - 5 : $HOME/.config/yabai/scripts/move-to-space.sh space-5
ctrl + cmd - 6 : $HOME/.config/yabai/scripts/move-to-space.sh space-6
ctrl + cmd - 7 : $HOME/.config/yabai/scripts/move-to-space.sh space-7
ctrl + cmd - 8 : $HOME/.config/yabai/scripts/move-to-space.sh space-8
ctrl + cmd - 9 : $HOME/.config/yabai/scripts/move-to-space.sh space-9
