#!/usr/bin/env bash

# yabai config - SIP-safe defaults

set -o pipefail

# shellcheck source=scripts/ignore-list.sh
. "${HOME}/.config/yabai/scripts/ignore-list.sh"

register_and_apply_rule() {
  local label="$1"

  shift
  yabai -m rule --remove "${label}" >/dev/null 2>&1 || :
  yabai -m rule --add label="${label}" "$@"
  yabai -m rule --apply "${label}"
}

register_signal() {
  local label="$1"

  shift
  yabai -m signal --remove "${label}" >/dev/null 2>&1 || :
  yabai -m signal --add label="${label}" "$@"
}

sketchy_bar_signal_action() {
  local event="$1"
  local sketchybar_bin="$2"

  printf '%s --trigger yabai_event SOURCE=yabai EVENT=%s' "${sketchybar_bin}" "${event}"
  # These expansions belong to the shell yabai starts for the signal action.
  # shellcheck disable=SC2016
  printf '%s' ' WINDOW_ID=${YABAI_WINDOW_ID:-}'
  # shellcheck disable=SC2016
  printf '%s' ' SPACE_ID=${YABAI_SPACE_ID:-}'
  # shellcheck disable=SC2016
  printf '%s' ' SPACE_INDEX=${YABAI_SPACE_INDEX:-}'
  # shellcheck disable=SC2016
  printf '%s' ' RECENT_SPACE_ID=${YABAI_RECENT_SPACE_ID:-}'
  # shellcheck disable=SC2016
  printf '%s' ' RECENT_SPACE_INDEX=${YABAI_RECENT_SPACE_INDEX:-}'
  # shellcheck disable=SC2016
  printf '%s' ' DISPLAY_ID=${YABAI_DISPLAY_ID:-}'
  # shellcheck disable=SC2016
  printf '%s' ' DISPLAY_INDEX=${YABAI_DISPLAY_INDEX:-}'
  # shellcheck disable=SC2016
  printf '%s' ' RECENT_DISPLAY_ID=${YABAI_RECENT_DISPLAY_ID:-}'
  # shellcheck disable=SC2016
  printf '%s' ' RECENT_DISPLAY_INDEX=${YABAI_RECENT_DISPLAY_INDEX:-}'
}

register_sketchy_bar_signal() {
  local event="$1"
  local sketchybar_bin="$2"
  local label="bar-${event//_/-}"
  local action

  action="$(sketchy_bar_signal_action "${event}" "${sketchybar_bin}")"
  register_signal "${label}" event="${event}" action="${action}"
}

main() {
  local app
  local event
  local label
  local regex
  local apply_layout="${HOME}/.config/yabai/scripts/apply-layout.sh"
  local refocus="${HOME}/.config/yabai/scripts/refocus.sh"
  local skip_focus="${HOME}/.config/yabai/scripts/skip-focus.sh"
  local refresh_labels="${HOME}/.config/yabai/scripts/label-spaces-displays.sh"
  local sketchybar_bin
  local -a sketchy_bar_events=(
    application_terminated
    application_hidden
    application_visible
    window_created
    window_destroyed
    window_focused
    window_moved
    window_resized
    window_minimized
    window_deminimized
    space_created
    space_destroyed
    space_changed
    display_added
    display_removed
    display_moved
    display_resized
    display_changed
    mission_control_exit
  )

  sketchybar_bin="$(command -v sketchybar 2>/dev/null || printf '/opt/homebrew/bin/sketchybar')"

  # Apply manage=off rules before layout defaults so ignored windows are
  # excluded before yabai starts reconfiguring spaces on reload.
  while IFS= read -r app; do
    [[ -n "${app}" ]] || continue
    label="$(ignore_rule_label "${app}")"
    regex="$(ignore_app_regex "${app}")"
    register_and_apply_rule "${label}" app="${regex}" manage=off
  done < <(ignore_list)

  # Core defaults. apply-layout.sh applies display-aware overrides.
  yabai -m config \
    layout                       bsp \
    split_type                   auto \
    split_ratio                  0.50 \
    auto_balance                 off \
    window_placement             first_child \
    window_insertion_point       first \
    window_zoom_persist          on \
    mouse_follows_focus          on \
    focus_follows_mouse          off \
    window_shadow                on \
    window_opacity               off \
    window_animation_duration    0.0 \
    skip_window_focus_animation  on \
    top_padding                  4 \
    bottom_padding               4 \
    left_padding                 8 \
    right_padding                8 \
    window_gap                   8 \
    mouse_modifier               alt \
    mouse_action1                move \
    mouse_action2                resize \
    mouse_drop_action            stack

  yabai -m config external_bar all:0:28

  # Label displays and spaces by physical left-to-right order.
  "${refresh_labels}"

  # Re-apply layout when window/application visibility changes.
  register_signal "layout-window-created" \
    event=window_created action="${apply_layout}"
  register_signal "layout-window-destroyed" \
    event=window_destroyed action="${apply_layout}"
  register_signal "layout-application-hidden" \
    event=application_hidden action="${apply_layout}"
  register_signal "layout-application-visible" \
    event=application_visible action="${apply_layout}"
  register_signal "layout-window-minimized" \
    event=window_minimized action="${apply_layout}"
  register_signal "layout-window-deminimized" \
    event=window_deminimized action="${apply_layout}"

  # Repair focus after close/minimize/hide leaves no visible window focused.
  register_signal "refocus-window-destroyed-active" \
    event=window_destroyed active=yes action="${refocus}"
  register_signal "refocus-window-minimized-active" \
    event=window_minimized active=yes action="${refocus}"
  register_signal "refocus-application-hidden-active" \
    event=application_hidden active=yes action="${refocus}"

  # Re-apply layout when focus moves to another space/display.
  register_signal "layout-space-changed" \
    event=space_changed action="${skip_focus}; ${apply_layout}"
  register_signal "layout-display-changed" \
    event=display_changed action="${skip_focus}; ${apply_layout}"

  # Re-label spaces when the space set changes.
  register_signal "label-space-created" \
    event=space_created action="${refresh_labels}"
  register_signal "label-space-destroyed" \
    event=space_destroyed action="${refresh_labels}"

  # Re-label displays/spaces when display topology changes.
  register_signal "label-display-added" \
    event=display_added action="${refresh_labels}"
  register_signal "label-display-removed" \
    event=display_removed action="${refresh_labels}"
  register_signal "label-display-moved" \
    event=display_moved action="${refresh_labels}"
  register_signal "label-display-resized" \
    event=display_resized action="${refresh_labels}; ${apply_layout}"

  # Forward typed events to the persistent bar controller. window_focused takes
  # this direct CLI path so selection does not wait for any yabai query.
  for event in "${sketchy_bar_events[@]}"; do
    register_sketchy_bar_signal "${event}" "${sketchybar_bin}"
  done

  "${apply_layout}"
  printf '%s\n' "yabai config loaded"
}

main "$@"
