#!/usr/bin/env bash

# yabai config - SIP-safe defaults

set -o pipefail

# shellcheck source=scripts/ignore-list.sh
. "${HOME}/.config/yabai/scripts/ignore-list.sh"

replace_and_apply_rule() {
  local label="$1"

  shift
  yabai -m rule --remove "${label}" >/dev/null 2>&1 || :
  yabai -m rule --add label="${label}" "$@"
  yabai -m rule --apply "${label}"
}

replace_signal() {
  local label="$1"

  shift
  yabai -m signal --remove "${label}" >/dev/null 2>&1 || :
  yabai -m signal --add label="${label}" "$@"
}

main() {
  local app
  local label
  local regex
  local apply_layout="${HOME}/.config/yabai/scripts/apply-layout.sh"
  local refocus="${HOME}/.config/yabai/scripts/refocus.sh"
  local skip_focus="${HOME}/.config/yabai/scripts/skip-focus.sh"
  local refresh_labels="${HOME}/.config/yabai/scripts/label-spaces-displays.sh"

  # Apply manage=off rules before layout defaults so ignored windows are
  # excluded before yabai starts reconfiguring spaces on reload.
  while IFS= read -r app; do
    [[ -n "${app}" ]] || continue
    label="$(ignore_rule_label "${app}")"
    regex="$(ignore_app_regex "${app}")"
    replace_and_apply_rule "${label}" app="${regex}" manage=off
  done < <(ignore_list)

  # Core defaults. apply-layout.sh applies display-aware overrides.
  yabai -m config \
    layout                       bsp \
    split_type                   auto \
    split_ratio                  0.50 \
    auto_balance                 off \
    window_placement             first_child \
    window_insertion_point       first \
    window_zoom_persist          on \
    mouse_follows_focus          on \
    focus_follows_mouse          off \
    window_shadow                on \
    window_opacity               off \
    window_animation_duration    0.0 \
    skip_window_focus_animation  off \
    top_padding                  6 \
    bottom_padding               8 \
    left_padding                 8 \
    right_padding                8 \
    window_gap                   8 \
    mouse_modifier               alt \
    mouse_action1                move \
    mouse_action2                resize \
    mouse_drop_action            stack

  # Label displays and spaces by physical left-to-right order.
  "${refresh_labels}"

  # Re-apply layout when window/application visibility changes.
  replace_signal "layout-window-created" \
    event=window_created action="${apply_layout}"
  replace_signal "layout-window-destroyed" \
    event=window_destroyed action="${apply_layout}"
  replace_signal "layout-application-hidden" \
    event=application_hidden action="${apply_layout}"
  replace_signal "layout-application-visible" \
    event=application_visible action="${apply_layout}"
  replace_signal "layout-window-minimized" \
    event=window_minimized action="${apply_layout}"
  replace_signal "layout-window-deminimized" \
    event=window_deminimized action="${apply_layout}"

  # Repair focus after close/minimize/hide leaves no visible window focused.
  replace_signal "refocus-window-destroyed-active" \
    event=window_destroyed active=yes action="${refocus}"
  replace_signal "refocus-window-minimized-active" \
    event=window_minimized active=yes action="${refocus}"
  replace_signal "refocus-application-hidden-active" \
    event=application_hidden active=yes action="${refocus}"

  # Re-apply layout when focus moves to another space/display.
  replace_signal "layout-space-changed" \
    event=space_changed action="${skip_focus}; ${apply_layout}"
  replace_signal "layout-display-changed" \
    event=display_changed action="${skip_focus}; ${apply_layout}"

  # Re-label spaces when the space set changes.
  replace_signal "label-space-created" \
    event=space_created action="${refresh_labels}"
  replace_signal "label-space-destroyed" \
    event=space_destroyed action="${refresh_labels}"

  # Re-label displays/spaces when display topology changes.
  replace_signal "label-display-added" \
    event=display_added action="${refresh_labels}"
  replace_signal "label-display-removed" \
    event=display_removed action="${refresh_labels}"
  replace_signal "label-display-moved" \
    event=display_moved action="${refresh_labels}"
  replace_signal "label-display-resized" \
    event=display_resized action="${refresh_labels}; ${apply_layout}"

  "${apply_layout}"
  printf '%s\n' "yabai config loaded"
}

main "$@"
